    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-core\**;obj-ui\**;bin-core\**;bin-ui\**;obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
