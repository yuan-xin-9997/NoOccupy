<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>NoOccupy</RootNamespace>
    <AssemblyName>NoOccupy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <Product>解除占用 (NoOccupy)</Product>
    <Company>NoOccupy</Company>
    <Description>一键解除文件或文件夹被程序占用</Description>
    <Copyright>Copyright © 2026 NoOccupy</Copyright>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-core\**;obj-ui\**;bin-core\**;bin-ui\**;obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Compile Include="..\Shared\UiLanguage.cs" Link="Localization\UiLanguage.cs" />
    <Compile Include="..\Shared\UiDialog.cs" Link="Localization\UiDialog.cs" />
  </ItemGroup>

</Project>

